---
import PageLayout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ThemeFab from '~/components/common/ThemeFab.astro';

import Hero from '~/components/sections/Hero.astro';
import Capabilities from '~/components/sections/Capabilities.astro';
import Path from '~/components/sections/Path.astro';
import Contact from '~/components/sections/Contact.astro';
import Reveal from '~/components/sections/Reveal.astro';

import { SITE, I18N } from 'astrowind:config';
import { profile, links, seo } from '~/data/portfolio';

const metadata = {
  ...seo,
  ignoreTitleTemplate: true,
};

/**
 * Structured data is built only from facts this file and config.yaml already
 * state. The `sameAs` list only claims the profiles that are actually set, so
 * a search engine is never told about a link that does not exist yet.
 */
const personId = `${SITE?.site}/#person`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE?.site}/#webpage`,
    url: SITE?.site,
    name: seo.title,
    description: seo.description,
    inLanguage: I18N?.language,
    isPartOf: { '@id': `${SITE?.site}/#website` },
    about: { '@id': personId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: profile.fullName,
    jobTitle: profile.role,
    url: SITE?.site,
    ...(profile.email ? { email: `mailto:${profile.email}` } : {}),
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Málaga',
      addressCountry: 'ES',
    },
    knowsLanguage: ['es', 'en'],
    sameAs: [links.linkedin],
    worksFor: { '@type': 'Organization', name: 'Docline' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Málaga' },
  },
];
---

<PageLayout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <Reveal />
  <Hero />
  <Capabilities />
  <Path />
  <Contact />
  <ThemeFab />
</PageLayout>
