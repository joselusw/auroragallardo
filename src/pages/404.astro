---
import PageLayout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { profile } from '~/data/portfolio';
---

<PageLayout metadata={{ title: 'Page not found', description: 'That page does not exist.' }} hasHeader={false}>
  <section class="shell flex min-h-screen flex-col justify-center py-[var(--section-y)]">
    <p class="label text-ash">Error 404</p>

    <h1 class="mt-6 font-display text-display">
      <span class="sr-only">Page not found.</span>
      <span aria-hidden="true">Not here.</span>
    </h1>

    <div class="mt-10 flex flex-wrap items-center gap-6">
      <a href={getHomePermalink()} class="btn btn-solid">Back to the portfolio</a>
      <a
        href="https://www.linkedin.com/in/auroradpgallardo/"
        class="link-rule text-small"
        target="_blank"
        rel="noopener noreferrer"
      >
        Or find {profile.firstName} on LinkedIn
      </a>
    </div>
  </section>
</PageLayout>
