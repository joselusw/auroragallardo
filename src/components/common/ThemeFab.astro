---
import ToggleTheme from '~/components/common/ToggleTheme.astro';
---

<div class="theme-fab">
  <ToggleTheme label="Switch between light and dark" class="theme-fab__button" iconClass="theme-fab__icon" />
</div>

<style>
  .theme-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 35;
    animation: theme-fab-arrive 600ms cubic-bezier(0.2, 0.75, 0.25, 1) 500ms both;
  }

  .theme-fab :global(.theme-fab__button) {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid rgb(40 36 61 / 0.16);
    border-radius: 9999px;
    background: #fff;
    color: #28243d;
    box-shadow:
      0 0.65rem 1.8rem rgb(31 27 51 / 0.2),
      inset 0 1px rgb(255 255 255 / 0.14);
    cursor: pointer;
    transition:
      transform 260ms cubic-bezier(0.2, 0.75, 0.25, 1),
      background-color 260ms ease,
      color 260ms ease,
      box-shadow 260ms ease;
  }

  .theme-fab :global(.theme-fab__button:hover) {
    transform: translateY(-3px) rotate(-8deg);
    background: #28243d;
    color: #fff;
    box-shadow:
      0 0.9rem 2rem rgb(31 27 51 / 0.26),
      inset 0 1px rgb(255 255 255 / 0.2);
  }

  .theme-fab :global(.theme-fab__button:active) {
    transform: translateY(0) scale(0.94);
  }

  .theme-fab :global(.theme-fab__button:focus-visible) {
    outline: 3px solid #ff9580;
    outline-offset: 4px;
  }

  .theme-fab :global(.theme-fab__icon) {
    position: relative;
    display: block;
    width: 1.35rem;
    height: 1.35rem;
  }

  :global(.dark) .theme-fab :global(.theme-fab__button) {
    border-color: rgb(255 255 255 / 0.72);
    background: #211f20;
    color: #fff;
    box-shadow:
      0 0.65rem 1.8rem rgb(0 0 0 / 0.42),
      inset 0 1px rgb(255 255 255 / 0.12);
  }

  :global(.dark) .theme-fab :global(.theme-fab__button:hover) {
    background: #fff;
    color: #211f20;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-fab {
      animation: none;
    }

    .theme-fab :global(.theme-fab__button) {
      transition: none;
    }
  }

  @keyframes theme-fab-arrive {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.85);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
