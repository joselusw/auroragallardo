---
import { profile } from '~/data/portfolio';

/** Section anchors must carry the deployment base, or they resolve to the
 *  domain root on a GitHub Pages project site and the jump silently fails. */
const anchor = (id: string) => `${import.meta.env.BASE_URL}#${id}`;

const navLinks = [
  { text: 'Capabilities', href: anchor('capabilities') },
  { text: 'Experience', href: anchor('path') },
  { text: 'Contact', href: anchor('contact') },
];
---

<header class="site-header" id="header">
  <div class="shell flex items-center justify-between gap-6 py-5">
    <a href={anchor('top')} class="header-mark font-display">
      {profile.firstName}<span aria-hidden="true">.</span>
    </a>

    <nav class="hidden md:block flex-1" aria-label="Sections">
      <ul class="flex items-center justify-center gap-7">
        {
          navLinks.map(({ text, href }) => (
            <li>
              <a href={href} class="label link-rule" data-nav>
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={anchor('contact')} class="btn btn-sm hidden md:inline-flex"> Let’s talk </a>
      <button
        type="button"
        class="menu-toggle md:hidden"
        aria-expanded="false"
        aria-controls="menu-panel"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <span class="menu-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Slide-in panel. On phones this is the only navigation, so it carries the
     theme control and the contact link too. -->
<div class="menu-panel md:hidden" id="menu-panel" data-menu-panel inert>
  <div class="shell menu-panel__inner">
    <div class="menu-panel__top">
      <span class="menu-mark font-display">
        {profile.firstName}<span aria-hidden="true">.</span>
      </span>
      <button type="button" class="menu-close" data-menu-close>
        <span class="sr-only">Close menu</span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <nav class="menu-nav" aria-label="Sections">
      <p class="menu-kicker label">Explore the portfolio</p>
      <ul class="menu-list">
        {
          navLinks.map(({ text, href }) => (
            <li class="menu-list__item">
              <a href={href} class="menu-item" data-menu-link>
                <span class="menu-item__label font-display">{text}</span>
                <span class="menu-item__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="menu-panel__footer label">Product design <span aria-hidden="true">·</span> Málaga, Spain</p>
  </div>
</div>

<script>
  // The header rule appears only once the page has moved, so the hero opens on
  // a completely clean edge.
  const header = document.querySelector<HTMLElement>('#header');

  if (header) {
    const sync = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    sync();
    document.addEventListener('scroll', sync, { passive: true });
    document.addEventListener('astro:page-load', sync);
  }

  const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const closeBtn = panel?.querySelector<HTMLElement>('[data-menu-close]');

  const setOpen = (open: boolean) => {
    panel?.classList.toggle('is-open', open);
    panel?.toggleAttribute('inert', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('overflow-hidden', open);
    if (open) closeBtn?.focus();
    else toggle?.focus();
  };

  toggle?.addEventListener('click', () => setOpen(!panel?.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  panel?.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('is-open')) setOpen(false);
  });

  // The panel is per-page markup; a client-side navigation replaces it, so
  // close it whenever astro swaps the document.
  document.addEventListener('astro:before-preparation', () => {
    if (panel?.classList.contains('is-open')) {
      panel.classList.remove('is-open');
      panel.setAttribute('inert', '');
      document.documentElement.classList.remove('overflow-hidden');
    }
  });
</script>

<style>
  .header-mark {
    flex: 0 0 auto;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .header-mark span,
  .menu-mark span {
    color: #c95f4b;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  /* The rule only appears once the page has moved, so the hero opens on a
     completely clean edge. */
  .site-header[data-scrolled] {
    border-bottom-color: var(--hairline);
  }

  @media (width >= 48rem) {
    .site-header .menu-toggle {
      display: none;
    }
  }

  /* A 32px circle, straight from the reference. */
  .menu-toggle,
  .menu-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid var(--ink);
    cursor: pointer;
  }

  .menu-toggle-bar,
  .menu-toggle-bar::before,
  .menu-toggle-bar::after {
    display: block;
    width: 0.875rem;
    height: 1px;
    background-color: var(--ink);
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .menu-toggle-bar {
    position: relative;
  }

  .menu-toggle-bar::before,
  .menu-toggle-bar::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-toggle-bar::before {
    top: -4px;
  }

  .menu-toggle-bar::after {
    top: 4px;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bar {
    background-color: transparent;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bar::before {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bar::after {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Panel. 8px corners and a 1px inset from the viewport, as in the reference;
     full-bleed below the small breakpoint where there is no room for it. */
  .menu-panel {
    --menu-background: #f6f3ee;
    --menu-foreground: #262421;
    --menu-muted: #716c65;
    --menu-rule: rgb(38 36 33 / 0.16);
    --menu-accent: #6555ad;
    --menu-accent-ink: #fff;
    --menu-hover: #a94738;

    position: fixed;
    inset: 0;
    z-index: 50;
    width: 100vw;
    background-color: var(--menu-background);
    color: var(--menu-foreground);
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 240ms ease,
      transform 380ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  :global(.dark) .menu-panel {
    --menu-background: #211f20;
    --menu-foreground: #f6f3ee;
    --menu-muted: #b9b2a8;
    --menu-rule: rgb(246 243 238 / 0.2);
    --menu-accent: #c4b8ff;
    --menu-accent-ink: #211f20;
    --menu-hover: #ff9580;
  }

  .menu-panel__inner {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding-top: max(1.25rem, env(safe-area-inset-top));
    padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
  }

  .menu-panel.is-open {
    opacity: 1;
    transform: none;
  }

  .menu-panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.25rem 1rem;
  }

  .menu-mark {
    color: var(--menu-foreground);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .menu-close {
    border-color: currentColor;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 240ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .menu-close:hover {
    transform: rotate(90deg);
    background-color: var(--menu-foreground);
    color: var(--menu-background);
  }

  .menu-close:focus-visible,
  .menu-item:focus-visible {
    outline: 2px solid var(--menu-accent);
    outline-offset: 4px;
  }

  .menu-close span[aria-hidden] {
    position: relative;
    display: block;
    width: 0.75rem;
    height: 0.75rem;
  }

  .menu-close span[aria-hidden]::before,
  .menu-close span[aria-hidden]::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
  }

  .menu-close span[aria-hidden]::before {
    transform: rotate(45deg);
  }

  .menu-close span[aria-hidden]::after {
    transform: rotate(-45deg);
  }

  .menu-nav {
    width: 100%;
    margin-top: clamp(4rem, 10vh, 6rem);
    margin-bottom: auto;
    padding-block: 2rem;
  }

  .menu-kicker {
    margin-bottom: 1.25rem;
    color: var(--menu-accent);
    font-size: 0.65rem;
  }

  .menu-list {
    border-top: 1px solid var(--menu-rule);
  }

  .menu-list__item {
    border-bottom: 1px solid var(--menu-rule);
  }

  .menu-item {
    display: flex;
    min-height: clamp(5.25rem, 14vh, 7.5rem);
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    color: var(--menu-foreground);
    transition:
      color 220ms ease,
      padding 260ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .menu-item__label {
    font-size: clamp(2.4rem, 10vw, 4rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .menu-item__arrow {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--menu-rule);
    border-radius: 9999px;
    color: var(--menu-accent);
    font-size: 1.25rem;
    transition:
      color 220ms ease,
      background-color 220ms ease,
      border-color 220ms ease,
      transform 260ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .menu-item:hover,
  .menu-item:focus-visible {
    padding-inline: 0.5rem;
    color: var(--menu-hover);
  }

  .menu-item:hover .menu-item__arrow,
  .menu-item:focus-visible .menu-item__arrow {
    transform: rotate(45deg);
    border-color: var(--menu-accent);
    background-color: var(--menu-accent);
    color: var(--menu-accent-ink);
  }

  .menu-panel__footer {
    padding-top: 1rem;
    border-top: 1px solid var(--menu-rule);
    color: var(--menu-muted);
    font-size: 0.6rem;
  }

  .menu-panel__footer span {
    padding-inline: 0.4rem;
    color: #ff9580;
  }

  @media (width >= 30rem) and (width < 48rem) {
    .menu-panel__inner {
      padding-inline: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-close,
    .menu-item,
    .menu-item__arrow {
      transition: none;
    }
  }
</style>
