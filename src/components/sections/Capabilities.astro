---
import { capabilities } from '~/data/portfolio';

const cardStyles = ['capability-card--before', 'capability-card--design', 'capability-card--product'];
---

<section id="capabilities" class="capabilities shell scroll-mt-24">
  <header class="capabilities__heading" data-reveal>
    <div>
      <p class="label capabilities__eyebrow">The mix behind the work</p>
      <h2 class="font-display capabilities__title">More than pixels.<br /><span>More than a title.</span></h2>
    </div>
    <p class="capabilities__lede">{capabilities.lede}</p>
  </header>

  <div class="capabilities__grid">
    {
      capabilities.groups.map((group, index) => (
        <article
          class:list={['capability-card', cardStyles[index]]}
          data-reveal
          style={`--reveal-delay:${index * 110}ms`}
        >
          <div class="capability-card__art" aria-hidden="true">
            {index === 0 ? (
              <div class="before-art">
                <div class="before-art__orbit before-art__orbit--outer" />
                <div class="before-art__orbit before-art__orbit--inner" />
                <span class="before-art__center">
                  PEOPLE
                  <br />& SIGNALS
                </span>
                <span class="before-art__tag before-art__tag--one">SEO</span>
                <span class="before-art__tag before-art__tag--two">CONTENT</span>
                <span class="before-art__tag before-art__tag--three">DATA</span>
                <span class="before-art__tag before-art__tag--four">GROWTH</span>
              </div>
            ) : index === 1 ? (
              <div class="design-art">
                <div class="design-art__toolbar">
                  <i />
                  <i />
                  <i />
                  <span>Untitled — canvas</span>
                </div>
                <div class="design-art__canvas">
                  <div class="design-art__screen">
                    <span class="design-art__screen-mark">
                      good
                      <br />
                      morning<span>.</span>
                    </span>
                    <span class="design-art__screen-line design-art__screen-line--long" />
                    <span class="design-art__screen-line" />
                    <span class="design-art__screen-button">
                      Continue <b>↗</b>
                    </span>
                  </div>
                  <span class="design-art__cursor">
                    ↖<small>you</small>
                  </span>
                  <span class="design-art__selection" />
                </div>
              </div>
            ) : (
              <div class="product-art">
                <span class="product-art__label label">A product is a system</span>
                <div class="product-art__node product-art__node--need">
                  <b>Need</b>
                  <span>Understand the person</span>
                </div>
                <div class="product-art__connector product-art__connector--one" />
                <div class="product-art__node product-art__node--flow">
                  <b>Flow</b>
                  <span>Make it feel simple</span>
                </div>
                <div class="product-art__connector product-art__connector--two" />
                <div class="product-art__node product-art__node--care">
                  <b>Care</b>
                  <span>Make it work in real life</span>
                </div>
                <span class="product-art__spark product-art__spark--one">✳</span>
                <span class="product-art__spark product-art__spark--two">✳</span>
              </div>
            )}
          </div>

          <div class="capability-card__body">
            <div class="capability-card__meta label">
              <span>{group.phase}</span>
              <span class="capability-card__arrow" aria-hidden="true">
                ↗
              </span>
            </div>
            <h3 class="font-display">{group.title}</h3>
            <p class="capability-card__description">{group.description}</p>
            <div class="capability-card__skill-set">
              <p class="capability-card__skills-label label">Skills</p>
              <ul class="capability-card__skills" aria-label={`${group.title} skills`}>
                {group.items.map((item, skillIndex) => (
                  <li class:list={{ 'capability-card__skill--featured': skillIndex === 0 }}>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .capabilities {
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  .capabilities__heading {
    display: grid;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .capabilities__eyebrow {
    color: #ba5848;
  }

  .capabilities__title {
    margin-top: 0.85rem;
    font-size: clamp(2.75rem, 5.8vw, 5.25rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .capabilities__title span {
    color: #ba5848;
  }

  .capabilities__lede {
    max-width: 34ch;
    color: var(--ash);
    font-size: 1rem;
    line-height: 1.65;
  }

  .capabilities__grid {
    display: grid;
    gap: 1rem;
  }

  .capability-card {
    --card-bg: #f0e4d2;
    --card-ink: #282624;
    --card-muted: #645e57;
    --card-accent: #b94e3b;
    overflow: hidden;
    background: var(--card-bg);
    color: var(--card-ink);
    transition:
      transform 260ms cubic-bezier(0.2, 0.75, 0.25, 1),
      box-shadow 260ms ease;
  }

  .capability-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 1rem 2.5rem rgb(40 38 36 / 0.1);
  }

  .capability-card--design {
    --card-bg: #f1765d;
    --card-ink: #282624;
    --card-muted: #49332e;
    --card-accent: #fff8eb;
  }

  .capability-card--product {
    --card-bg: #a798ff;
    --card-ink: #252052;
    --card-muted: #4b456d;
    --card-accent: #f9f6ed;
  }

  .capability-card__art {
    position: relative;
    min-height: 11.5rem;
    overflow: hidden;
  }

  .capability-card__body {
    padding: 1.25rem 1.25rem 1.4rem;
  }

  .capability-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--card-muted);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .capability-card__arrow {
    color: var(--card-accent);
    font-size: 0.9rem;
    transition: transform 200ms ease;
  }

  .capability-card:hover .capability-card__arrow {
    transform: translate(2px, -2px);
  }

  .capability-card__body h3 {
    margin-top: 0.8rem;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .capability-card__description {
    min-height: 4.8em;
    margin-top: 0.7rem;
    color: var(--card-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .capability-card__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .capability-card__skill-set {
    margin-top: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--card-ink) 18%, transparent);
    padding-top: 0.75rem;
  }

  .capability-card__skills-label {
    color: var(--card-muted);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
  }

  .capability-card__skills li {
    border: 1px solid color-mix(in srgb, var(--card-ink) 10%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--card-ink) 7%, var(--card-bg));
    padding: 0.48rem 0.68rem;
    color: var(--card-ink);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .capability-card__skills .capability-card__skill--featured {
    border-color: transparent;
    background: var(--card-ink);
    color: var(--card-bg);
  }

  .capability-card:hover .capability-card__skills li {
    transform: translateY(-2px);
  }

  .capability-card:hover .capability-card__skills li:nth-child(2) {
    transition-delay: 25ms;
  }

  .capability-card:hover .capability-card__skills li:nth-child(3) {
    transition-delay: 50ms;
  }

  .capability-card:hover .capability-card__skills li:nth-child(4) {
    transition-delay: 75ms;
  }

  .capability-card:hover .capability-card__skills li:nth-child(5) {
    transition-delay: 100ms;
  }

  .before-art__orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    aspect-ratio: 1;
    border: 1px solid rgb(40 38 36 / 0.21);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .before-art__orbit--outer {
    width: 10.5rem;
    animation: capability-orbit 24s linear infinite;
  }

  .before-art__orbit--inner {
    width: 6.75rem;
    border-style: dashed;
  }

  .before-art__center {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 4.5rem;
    aspect-ratio: 1;
    place-content: center;
    border-radius: 50%;
    background: #282624;
    color: #f9f6ed;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    line-height: 1.4;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .before-art__tag {
    position: absolute;
    display: grid;
    min-width: 3.2rem;
    min-height: 1.5rem;
    place-items: center;
    border: 1px solid rgb(40 38 36 / 0.18);
    border-radius: 9999px;
    background: #fbf7ed;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    animation: tag-float 4s ease-in-out infinite;
  }

  .before-art__tag--one {
    top: 20%;
    left: 22%;
  }

  .before-art__tag--two {
    top: 25%;
    right: 17%;
    animation-delay: -1s;
  }

  .before-art__tag--three {
    bottom: 16%;
    left: 19%;
    animation-delay: -2s;
  }

  .before-art__tag--four {
    right: 18%;
    bottom: 16%;
    animation-delay: -3s;
  }

  .design-art {
    position: absolute;
    inset: 1.4rem 1.15rem 0;
    overflow: hidden;
    border: 1px solid rgb(40 38 36 / 0.18);
    background: #f7f3eb;
    box-shadow: 0 0.65rem 1.5rem rgb(40 38 36 / 0.1);
    transform: rotate(-2deg);
    transition: transform 300ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .capability-card:hover .design-art {
    transform: rotate(0deg) translateY(-2px);
  }

  .design-art__toolbar {
    display: flex;
    height: 1.65rem;
    align-items: center;
    gap: 0.25rem;
    border-bottom: 1px solid #ded8cf;
    padding-inline: 0.5rem;
  }

  .design-art__toolbar i {
    width: 0.3rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #f1765d;
  }

  .design-art__toolbar i:nth-child(2) {
    background: #e5bd5b;
  }

  .design-art__toolbar i:nth-child(3) {
    background: #859f77;
  }

  .design-art__toolbar span {
    margin-left: 0.3rem;
    color: #726d66;
    font-family: var(--font-mono);
    font-size: 0.48rem;
  }

  .design-art__canvas {
    position: relative;
    height: calc(100% - 1.65rem);
    background-image: radial-gradient(#d6d0c7 0.7px, transparent 0.7px);
    background-size: 9px 9px;
  }

  .design-art__screen {
    position: absolute;
    top: 12%;
    left: 29%;
    display: flex;
    width: 8.2rem;
    min-height: 8rem;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid #e2ddd4;
    background: #fffdf7;
    padding: 0.7rem;
    box-shadow: 0 0.5rem 1rem rgb(40 38 36 / 0.12);
    transition: transform 350ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .capability-card:hover .design-art__screen {
    transform: translateY(-5px);
  }

  .design-art__screen-mark {
    color: #282624;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .design-art__screen-mark span {
    color: #f1765d;
  }

  .design-art__screen-line {
    width: 58%;
    height: 0.2rem;
    margin-top: 0.42rem;
    background: #e6e0d7;
  }

  .design-art__screen-line--long {
    width: 85%;
    margin-top: 0.6rem;
  }

  .design-art__screen-button {
    display: flex;
    width: 100%;
    justify-content: space-between;
    margin-top: 0.7rem;
    background: #282624;
    padding: 0.35rem 0.45rem;
    color: #fffdf7;
    font-size: 0.5rem;
  }

  .design-art__screen-button b {
    color: #e7f276;
  }

  .design-art__cursor {
    position: absolute;
    top: 28%;
    left: 23%;
    color: #5b50b2;
    font-size: 1.15rem;
    animation: cursor-drift 3.2s ease-in-out infinite;
  }

  .design-art__cursor small {
    position: absolute;
    top: 0.95rem;
    left: 0.75rem;
    border-radius: 2px;
    background: #5b50b2;
    padding: 0.15rem 0.3rem;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.45rem;
  }

  .design-art__selection {
    position: absolute;
    top: 27%;
    right: 15%;
    width: 1.1rem;
    height: 1.4rem;
    border: 1px solid #5b50b2;
  }

  .design-art__selection::after {
    position: absolute;
    right: -0.2rem;
    bottom: -0.2rem;
    width: 0.3rem;
    height: 0.3rem;
    background: #5b50b2;
    content: '';
  }

  .product-art {
    position: absolute;
    inset: 0;
  }

  .product-art__label {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    color: rgb(37 32 82 / 0.62);
    font-size: 0.52rem;
  }

  .product-art__node {
    position: absolute;
    z-index: 1;
    display: grid;
    width: 8.5rem;
    gap: 0.2rem;
    border: 1px solid rgb(37 32 82 / 0.12);
    background: #f9f6ed;
    padding: 0.55rem 0.65rem;
    box-shadow: 0 0.5rem 1rem rgb(37 32 82 / 0.1);
    transition: transform 250ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .product-art__node b {
    font-size: 0.75rem;
  }

  .product-art__node span {
    color: #4b456d;
    font-size: 0.56rem;
    line-height: 1.35;
  }

  .product-art__node--need {
    top: 26%;
    left: 8%;
    transform: rotate(-5deg);
  }

  .product-art__node--flow {
    top: 44%;
    left: 36%;
    transform: rotate(3deg);
  }

  .product-art__node--care {
    right: 6%;
    bottom: 11%;
    transform: rotate(-4deg);
  }

  .capability-card:hover .product-art__node--need {
    transform: translateY(-4px) rotate(-7deg);
  }

  .capability-card:hover .product-art__node--flow {
    transform: translateY(-6px) rotate(5deg);
  }

  .capability-card:hover .product-art__node--care {
    transform: translateY(-3px) rotate(-6deg);
  }

  .product-art__connector {
    position: absolute;
    height: 1px;
    background: rgb(37 32 82 / 0.45);
    transform-origin: left;
  }

  .product-art__connector--one {
    top: 48%;
    left: 34%;
    width: 22%;
    transform: rotate(22deg);
  }

  .product-art__connector--two {
    top: 64%;
    left: 64%;
    width: 21%;
    transform: rotate(35deg);
  }

  .product-art__spark {
    position: absolute;
    color: #f1765d;
    animation: capability-orbit 15s linear infinite;
  }

  .product-art__spark--one {
    top: 23%;
    right: 18%;
  }

  .product-art__spark--two {
    bottom: 15%;
    left: 18%;
    color: #e7f276;
    animation-direction: reverse;
    animation-duration: 20s;
  }

  @media (width >= 48rem) {
    .capabilities__heading {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.55fr);
      gap: 3rem;
    }

    .capabilities__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
      gap: 1rem;
    }

    .capability-card:nth-child(2) {
      margin-top: 1.75rem;
      margin-bottom: 1.75rem;
    }

    .capability-card:first-child {
      margin-bottom: 3.5rem;
    }

    .capability-card:last-child {
      margin-top: 3.5rem;
    }

    .capability-card__art {
      min-height: clamp(10.5rem, 14vw, 13rem);
    }

    .capability-card__body {
      padding: 1.15rem 1rem 1.25rem;
    }
  }

  @media (width >= 80rem) {
    .capabilities__grid {
      gap: 1.25rem;
    }

    .capability-card__art {
      min-height: 13rem;
    }

    .capability-card__body {
      padding: 1.4rem 1.35rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capability-card,
    .capability-card__arrow,
    .before-art__orbit--outer,
    .before-art__tag,
    .design-art,
    .design-art__screen,
    .design-art__cursor,
    .product-art__node,
    .product-art__spark,
    .capability-card__skills li {
      animation: none;
      transition: none;
    }
  }

  @keyframes capability-orbit {
    to {
      transform: translate(-50%, -50%) rotate(1turn);
    }
  }

  @keyframes tag-float {
    50% {
      translate: 0 -0.3rem;
    }
  }

  @keyframes cursor-drift {
    50% {
      translate: 0.25rem -0.25rem;
    }
  }
</style>
