<style is:global>
  html.motion-ready [data-reveal]:not(.is-visible) {
    opacity: 0;
    transform: translate3d(0, 2rem, 0);
  }

  html.motion-ready [data-reveal] {
    transition:
      opacity 650ms cubic-bezier(0.2, 0.75, 0.25, 1),
      transform 650ms cubic-bezier(0.2, 0.75, 0.25, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    html.motion-ready [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;

  const observeReveals = () => {
    observer?.disconnect();
    document.documentElement.classList.add('motion-ready');

    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer?.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -36px 0px' }
    );

    elements.forEach((element) => observer?.observe(element));
  };

  observeReveals();
  document.addEventListener('astro:page-load', observeReveals);
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>
